VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: fallback REST API base used by other services
VITE_API_BASE_URL=/api

# Firebase web client config (public identifiers - match the values shown in
# Firebase Console > Project settings > Your apps, and public/firebase-messaging-sw.js)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# FCM Web Push VAPID key (public). Get it from Firebase Console > Project
# settings > Cloud Messaging > Web Push certificates. Required for web push.
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key
