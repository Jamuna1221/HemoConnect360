# HemoConnect360 backend environment
# Copy to .env and fill in the values.

# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Supabase (use the publishable/anon key - NEVER the service-role key here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-key

# Supabase service-role key (server-side only - used to auto-confirm the
# Blood Bank auth account so registration needs NO email verification).
# Get it from Dashboard > Settings > API. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Requester phone-login token signing (defaults to SUPABASE_KEY when unset)
REQUESTER_TOKEN_SECRET=

# Donor matching
DONOR_MATCH_RADIUS_KM=10
DONOR_MATCH_MAX_DONORS=25

# Blood bank verification document uploads (MB)
BLOOD_BANK_DOC_MAX_MB=5
